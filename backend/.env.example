# Copy this to .env and fill in real values. Never commit the real .env.

# Supabase project settings — Project Settings -> API in the Supabase dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Paystack — dashboard.paystack.com -> Settings -> API Keys & Webhooks
# Use the sk_test_/pk_test_ keys until you're ready to go live.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# The deployed frontend origin — used for CORS. Include the scheme, no trailing slash.
FRONTEND_ORIGIN=http://localhost:3000

# Job sizing caps
MAX_CATEGORIES_PER_JOB=8
MAX_CITIES_PER_JOB=8
MAX_PAGES_PER_SEARCH=3
REQUEST_DELAY_SECONDS=1.5
WEBSITE_TIMEOUT_SECONDS=8

# Total businesses delivered per generation (split evenly across selected
# cities, randomly sampled, phone+email both required)
RESULTS_PER_JOB=10
